{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AlgoDesk-Algorithmen",
  "type": "object",
  "required": ["schemaVersion", "algorithms"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "algorithms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "kind", "summary", "requirement", "complexity", "concepts", "lines"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["search", "sort"] },
          "summary": { "type": "string", "minLength": 1 },
          "requirement": { "type": "string", "minLength": 1 },
          "complexity": {
            "type": "object",
            "required": ["best", "average", "worst", "memory"],
            "additionalProperties": { "type": "string" }
          },
          "concepts": { "type": "array", "items": { "type": "string" } },
          "lines": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
