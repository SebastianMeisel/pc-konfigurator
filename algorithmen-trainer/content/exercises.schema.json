{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AlgoDesk-Übungen",
  "type": "object",
  "required": ["schemaVersion", "deskTests", "debugChallenges", "helpCards"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "deskTests": { "type": "array", "items": { "$ref": "#/$defs/baseExercise" } },
    "debugChallenges": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "#/$defs/baseExercise" },
          {
            "type": "object",
            "required": ["buggyLines", "question", "options", "evidence", "explanation"],
            "properties": {
              "buggyLines": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "question": { "type": "string", "minLength": 1 },
              "options": {
                "type": "array", "minItems": 2,
                "items": {
                  "type": "object", "required": ["id", "text", "correct"],
                  "properties": { "id": { "type": "string" }, "text": { "type": "string" }, "correct": { "type": "boolean" } },
                  "additionalProperties": false
                }
              },
              "evidence": { "type": "string", "minLength": 1 },
              "explanation": { "type": "string", "minLength": 1 }
            }
          }
        ]
      }
    },
    "helpCards": {
      "type": "array",
      "items": {
        "type": "object", "required": ["title", "text"],
        "properties": { "title": { "type": "string" }, "text": { "type": "string" } },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "baseExercise": {
      "type": "object",
      "required": ["id", "algorithm", "values", "title"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "algorithm": { "type": "string" },
        "values": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "integer" } },
        "target": { "type": "integer" },
        "title": { "type": "string", "minLength": 1 },
        "difficulty": { "enum": ["leicht", "mittel", "schwer"] }
      }
    }
  }
}
