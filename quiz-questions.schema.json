{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quiz-questions.schema.json",
  "title": "BuildBench Quizfragen",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "title",
    "testSize",
    "questions"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "testSize": {
      "type": "integer",
      "minimum": 1
    },
    "questions": {
      "type": "array",
      "minItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "question",
          "hint",
          "options",
          "correctAnswer"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^q[0-9]{3,}$"
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "hint": {
            "type": "string",
            "minLength": 1
          },
          "options": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "text",
                "feedback"
              ],
              "properties": {
                "id": {
                  "enum": [
                    "A",
                    "B",
                    "C",
                    "D"
                  ]
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "feedback": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "correctAnswer": {
            "enum": [
              "A",
              "B",
              "C",
              "D"
            ]
          }
        }
      }
    }
  }
}
