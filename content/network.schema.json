{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "network.schema.json",
  "title": "BuildBench-Netzwerkoptionen",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "groups", "boards"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "groups": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "lessonId", "options"],
        "properties": {
          "id": { "enum": ["ethernet", "wifi"] },
          "label": { "type": "string", "minLength": 1 },
          "lessonId": { "type": "string", "minLength": 1 },
          "options": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "name", "price", "slot", "speed", "specs"],
              "properties": {
                "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
                "name": { "type": "string", "minLength": 1 },
                "price": { "type": "number", "minimum": 0 },
                "slot": { "type": "integer", "minimum": 0 },
                "speed": { "type": "string", "minLength": 1 },
                "specs": { "type": "string", "minLength": 1 },
                "generation": { "type": "integer", "minimum": 1, "maximum": 2 }
              }
            }
          }
        }
      }
    },
    "boards": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "form", "lan", "wifi"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "form": { "enum": ["ATX", "mATX", "ITX"] },
          "lan": { "type": "string", "minLength": 1 },
          "wifi": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
