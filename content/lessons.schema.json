{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lessons.schema.json",
  "title": "BuildBench-Lernkarten",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "lessons"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "lessons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "role", "install", "safety", "check"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "install": { "$ref": "#/$defs/textList" },
          "safety": { "$ref": "#/$defs/textList" },
          "check": { "$ref": "#/$defs/textList" }
        }
      }
    }
  },
  "$defs": {
    "textList": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
